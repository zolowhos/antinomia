# phase3_state_demo.re - Phase 3 Pack C agent snapshot / paging demo.
# Module: demo (antinomia script).
# Owns: init -> BP -> run -> state -> mem.page -> trace.query -> detach.
# Depends: antinomia CLI. @INFERIOR@ substituted at configure time.

init @INFERIOR@
wait_event 5000
wait_event 5000
bp loop_inferior:antinomia_touch
run
wait_event 5000
state --limit 8
log agent_break
state --limit 4
mem.page --limit 64 --offset 0
mem.page --limit 64 --cursor 64
maps --limit 2 --offset 0
tracestart
tracestep 6
trace.query --limit 2 --offset 0
trace.query --limit 2 --cursor 2
# Prefer kill in headless CI: detach can leave a live inferior that
# stalls cmake execute_process pipe teardown on some hosts.
kill
