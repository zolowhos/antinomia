# .editorconfig - editor parity so formatting matches .clang-format without a plugin.
# Module: build (INI).
# Owns: charset, line endings, indentation and final-newline behavior for all editors.
# Depends: mirrors .clang-format. Clang-format wins where the two overlap.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,rules}]
indent_size = 2
max_line_length = 100

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab

[LICENSE]
insert_final_newline = true
trim_trailing_whitespace = false
